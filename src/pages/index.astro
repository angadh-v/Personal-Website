---
import Layout from '../layouts/Layout.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import ProjectCard from '@/components/ui/ProjectCard.astro'
import ExperienceTimeline from '@/components/ui/ExperienceTimeline.astro'
import SocialIcons from '@/components/ui/SocialIcons.astro'
import { profile, template } from '@/settings'
import {
	contact,
	education,
	experiences,
	featuredProjects,
	projectCategories,
} from '@/data/portfolio'
---

<Layout>
	<section class='grid gap-12 border-b border-base-content/10 pb-12 lg:grid-cols-[1.35fr_0.85fr] lg:items-center'>
		<div class='space-y-6'>
			<div class='space-y-5'>
				<h1 class='max-w-4xl text-5xl font-bold leading-tight text-base-content lg:text-6xl'>
					{profile.fullName}
				</h1>
				<p class='max-w-2xl text-xl text-base-content/75'>
					{profile.title}
				</p>
				<p class='max-w-3xl text-lg leading-relaxed text-base-content/78'>
					{profile.heroSummary}
				</p>
			</div>

			<div class='flex flex-wrap gap-3'>
				<a href={`${template.base}/projects`} class='btn btn-secondary'>
					View Projects
				</a>
				<a href={`${template.base}/resume-angadh-verma.pdf`} download class='btn btn-outline'>
					Download Resume
				</a>
			</div>
		</div>

		<div class='border border-base-content/10 bg-base-200 p-8'>
			<p class='text-sm leading-relaxed text-base-content/70'>{profile.location}</p>
			<p class='mt-4 text-base leading-relaxed text-base-content/70'>
				Industry projects, research work, and personal products are separated so each body of work can be browsed on its own terms.
			</p>
			<div class='mt-6 max-w-xs'>
				<SocialIcons />
			</div>
		</div>
	</section>

	<section class='border-b border-base-content/10 py-12'>
		<SectionHeading
			eyebrow='Selected Work'
			title='Featured projects'
			description='One selected project from each category.'
		/>
		<div class='mt-8 grid gap-6 lg:grid-cols-3'>
			{featuredProjects.map((project) => (
				<ProjectCard project={project} compact={true} />
			))}
		</div>
	</section>

	<section class='border-b border-base-content/10 py-12'>
		<SectionHeading
			eyebrow='Projects'
			title='Browse by category'
			description='Projects are separated into industry, research, and personal work.'
		/>
		<div class='mt-6 flex flex-wrap gap-4 text-base'>
			{projectCategories.map((category) => (
				<a href={`${template.base}/projects#${category.id}`} class='link link-hover'>
					{category.label}
				</a>
			))}
		</div>
	</section>

	<section class='border-b border-base-content/10 py-12'>
		<SectionHeading
			eyebrow='Experience'
			title='Recent experience'
		/>
		<div class='mt-8'>
			<ExperienceTimeline entries={experiences.slice(0, 3)} />
		</div>
		<div class='mt-6'>
			<a href={`${template.base}/experience`} class='link link-hover'>View full experience</a>
		</div>
	</section>

	<section class='py-12' id='contact'>
		<SectionHeading
			eyebrow='Contact'
			title='Contact'
		/>
		<div class='mt-6 space-y-3 text-base-content/75'>
			<p>{contact.email}</p>
			<p>{contact.phone}</p>
			<p>{contact.location}</p>
			<p>{education[0].school}</p>
			<div class='pt-2'>
				<a href={`${template.base}/resume-angadh-verma.pdf`} class='link link-hover' download>
					Download resume PDF
				</a>
			</div>
		</div>
	</section>
</Layout>
