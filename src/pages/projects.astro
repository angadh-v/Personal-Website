---
import Layout from '@/layouts/Layout.astro'
import ProjectCard from '@/components/ui/ProjectCard.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import { projectCategories, projects } from '@/data/portfolio'

const defaultCategory = projectCategories[0]?.id ?? 'industry'
const projectsByCategory = projectCategories.map((category) => ({
	...category,
	projects: projects.filter((project) => project.category === category.id),
}))
---

<Layout title='Projects | Angadh Verma'>
	<section class='border-b border-base-content/10 pb-12'>
		<SectionHeading
			eyebrow=''
			title='Projects'
			description='Industry, research, and personal work are grouped separately.'
		/>
		<div class='project-tabs mt-6 inline-flex w-fit rounded-full border border-base-content/10 bg-[linear-gradient(135deg,hsl(var(--p)/0.12),transparent_55%),hsl(var(--b2)/0.8)] p-1 shadow-[0_12px_30px_hsl(var(--bc)/0.06)] backdrop-blur'>
			{projectCategories.map((category) => (
				<button
					type='button'
					class='tab rounded-full border-0 bg-transparent px-5'
					data-project-color={category.id}
					data-project-tab={category.id}
					aria-controls={`panel-${category.id}`}
				>
					{category.label}
				</button>
			))}
		</div>
	</section>

	<div class='py-12'>
		{projectsByCategory.map((group) => (
			<section
				id={`panel-${group.id}`}
				class='w-full'
				data-project-panel={group.id}
				hidden={group.id !== defaultCategory}
			>
				{/* <div class='max-w-2xl'>
					<p class='text-sm font-medium text-base-content/60'>{group.label}</p>
					<h2 class='mt-2 text-3xl font-bold'>{group.headline}</h2>
					<p class='mt-3 text-base leading-relaxed text-base-content/72'>{group.description}</p>
				</div> */}
				<div class='mt-8 grid gap-6'>
					{group.projects.map((project) => (
						<ProjectCard project={project} />
					))}
				</div>
			</section>
		))}
	</div>
</Layout>

<script is:inline>
	const setupProjectTabs = () => {
		const tabs = Array.from(document.querySelectorAll('[data-project-tab]'));
		const panels = Array.from(document.querySelectorAll('[data-project-panel]'));

		if (tabs.length === 0 || panels.length === 0) {
			return;
		}

		const activate = (id) => {
			tabs.forEach((tab) => {
				const isActive = tab.dataset.projectTab === id;
				tab.classList.toggle('tab-active', isActive);
				tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
			});

			panels.forEach((panel) => {
				panel.hidden = panel.dataset.projectPanel !== id;
			});
		};

		const hash = window.location.hash.replace('#', '');
		const validHash = tabs.some((tab) => tab.dataset.projectTab === hash);
		activate(validHash ? hash : tabs[0].dataset.projectTab);

		tabs.forEach((tab) => {
			if (tab.dataset.bound === 'true') {
				return;
			}

			tab.dataset.bound = 'true';
			tab.addEventListener('click', () => {
				const id = tab.dataset.projectTab;
				if (!id) {
					return;
				}

				activate(id);
				history.replaceState(null, '', `${window.location.pathname}#${id}`);
			});
		});
	};

	setupProjectTabs();
	document.addEventListener('astro:page-load', setupProjectTabs);
</script>

<style>
	.project-tabs .tab {
		color: hsl(var(--bc) / 0.7);
		transition:
			background-color 160ms ease,
			color 160ms ease,
			box-shadow 160ms ease,
			transform 160ms ease;
	}

	.project-tabs .tab:hover {
		color: hsl(var(--bc));
		background: hsl(var(--b1) / 0.5);
	}

	.project-tabs .tab.tab-active {
		color: hsl(var(--bc));
		box-shadow: 0 8px 20px hsl(var(--bc) / 0.08);
	}

	.project-tabs .tab[data-project-color='industry'].tab-active {
		background: linear-gradient(90deg, hsl(var(--p) / 0.2), hsl(var(--p) / 0.08));
		color: hsl(var(--p));
	}

	.project-tabs .tab[data-project-color='research'].tab-active {
		background: linear-gradient(90deg, hsl(var(--s) / 0.2), hsl(var(--s) / 0.08));
		color: hsl(var(--s));
	}

	.project-tabs .tab[data-project-color='personal'].tab-active {
		background: linear-gradient(90deg, hsl(var(--a) / 0.2), hsl(var(--a) / 0.08));
		color: hsl(var(--a));
	}

	@media (prefers-reduced-motion: reduce) {
		.project-tabs .tab {
			transition: none;
		}
	}
</style>
