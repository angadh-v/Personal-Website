---
import Layout from '@/layouts/Layout.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import { contact, education, experiences, skillGroups } from '@/data/portfolio'
import { template } from '@/settings'
---

<Layout title='Resume | Angadh Verma'>
	<section class='border-b border-base-content/10 pb-12'>
		<SectionHeading
			eyebrow='Resume'
			title='Resume'
			description='A web version of the current CV.'
		/>
		<div class='mt-6 flex flex-wrap gap-3'>
			<a href={`${template.base}/Angadh-CV.pdf`} class='btn btn-secondary' download>
				Download PDF
			</a>
			<a href={`mailto:${contact.email}`} class='btn btn-outline'>
				Email Angadh
			</a>
		</div>
	</section>

	<div class='grid gap-10 py-12 xl:grid-cols-[1.15fr_0.85fr]'>
		<section class='space-y-10'>
			<div class='border border-base-content/10 bg-base-100 p-6'>
				<p class='font-medium text-base-content/60'>Profile</p>
				<p class='mt-4 leading-relaxed text-base-content/75'>
					Software engineer and applied ML builder with experience across production retrieval systems, causal geospatial research, and full-stack product development.
				</p>
			</div>

			<div class='border border-base-content/10 bg-base-100 p-6'>
				<p class='font-medium text-base-content/60'>Experience</p>
				<div class='mt-6 space-y-6'>
					{experiences.map((entry) => (
						<div class='border-b border-base-content/10 pb-5 last:border-b-0 last:pb-0'>
							<div class='flex flex-wrap items-start justify-between gap-3'>
								<div>
									<h2 class='text-lg font-bold'>{entry.role}</h2>
									<p class='mt-1 text-base-content/70'>{entry.organization}</p>
								</div>
								<div class='text-right text-sm text-base-content/55'>
									<div>{entry.dates}</div>
									<div>{entry.location}</div>
								</div>
							</div>
							<p class='mt-3 text-base-content/72'>{entry.summary}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class='space-y-10'>
			<div class='border border-base-content/10 bg-base-100 p-6'>
				<p class='font-medium text-base-content/60'>Education</p>
				<div class='mt-5 space-y-4'>
					<h2 class='text-lg font-bold'>{education[0].degree}</h2>
					<p>{education[0].school}</p>
					<p class='text-base-content/70'>{education[0].location}</p>
					<p class='text-base-content/70'>{education[0].dates}</p>
					<p class='text-base-content/75'>{education[0].description}</p>
					<p class='text-base-content/75'>
						<strong class='font-medium text-base-content/80'>Honors:</strong> {education[0].honors.join(', ')}
					</p>
				</div>
			</div>

			<div class='border border-base-content/10 bg-base-100 p-6'>
				<p class='font-medium text-base-content/60'>Skills</p>
				<div class='mt-6 space-y-6'>
					{skillGroups.map((group) => (
						<div>
							<h2 class='text-base font-bold'>{group.title}</h2>
							<p class='mt-2 text-base-content/72'>{group.items.join(', ')}</p>
						</div>
					))}
				</div>
			</div>

			<div class='border border-base-content/10 bg-base-100 p-6'>
				<p class='font-medium text-base-content/60'>Contact</p>
				<div class='mt-5 space-y-3 text-base-content/78'>
					<p>{contact.email}</p>
					<p>{contact.phone}</p>
					<p>{contact.location}</p>
				</div>
			</div>
		</section>
	</div>
</Layout>
