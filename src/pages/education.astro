---
import Layout from '@/layouts/Layout.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import { education } from '@/data/portfolio'

const currentEducation = education[0]
---

<Layout title='Education | Angadh Verma'>
	<section class='border-b border-base-content/10 pb-12'>
		<SectionHeading
			eyebrow='Education'
			title={currentEducation.school}
		/>
		<div class='mt-3 space-y-1 text-base leading-relaxed text-base-content/72'>
			<p>{currentEducation.degree}</p>
			<p>2022-2026</p>
		</div>
	</section>

	<div class='space-y-10 py-12'>

		<section class='border border-base-content/10 bg-base-100 p-6'>
			<p class='font-medium text-base-content/60'>Awards</p>
			<ul class='mt-4 space-y-2 text-base-content/75'>
				{currentEducation.honors.map((item) => (
					<li>{item}</li>
				))}
			</ul>
		</section>

		<section class='border border-base-content/10 bg-base-100 p-6'>
			<p class='font-medium text-base-content/60'>Extracurricular Involvement</p>
			<div class='mt-6 space-y-6'>
				{currentEducation.extracurricularInvolvement.map((entry) => (
					<div class='border-b border-base-content/10 pb-5 last:border-b-0 last:pb-0'>
						<div class='flex flex-wrap items-start justify-between gap-3'>
							<div>
								<h2 class='text-lg font-bold'>{entry.role}</h2>
								<p class='mt-1 text-base-content/70'>{entry.organization}</p>
							</div>
							<div class='text-right text-sm text-base-content/55'>
								<div>{entry.dates}</div>
								<div>{entry.location}</div>
							</div>
						</div>
						<p class='mt-3 text-base-content/72'>{entry.summary}</p>
					</div>
				))}
			</div>
		</section>

		<section class='border border-base-content/10 bg-base-100 p-6'>
			<p class='font-medium text-base-content/60'>Selected Coursework</p>
			<p class='mt-4 text-base-content/75'>{currentEducation.coursework.join(', ')}</p>
		</section>

		<section class='border border-base-content/10 bg-base-100 p-6'>
			<p class='font-medium text-base-content/60'>Research Interests</p>
			<p class='mt-4 text-base-content/75'>{currentEducation.researchInterests.join(', ')}</p>
		</section>
	</div>
</Layout>
