---
interface Props {
	eyebrow: string
	title: string
	description?: string
}

const { eyebrow, title, description } = Astro.props
---

<div class='max-w-3xl'>
	<p class='text-sm font-medium uppercase tracking-[0.2em] text-primary'>{eyebrow}</p>
	<h2 class='mt-2 text-3xl font-bold text-base-content'>{title}</h2>
	{description && <p class='mt-3 text-base leading-relaxed text-base-content/72'>{description}</p>}
</div>
