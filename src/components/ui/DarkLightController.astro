---
---

<label
	class='flex items-center gap-3 rounded-full border border-base-content/10 bg-base-200/80 px-3 py-2 text-sm shadow-lg backdrop-blur'
	transition:persist
>
	<span class='hidden font-medium uppercase tracking-[0.22em] text-base-content/60 sm:inline'>Light</span>
	<input
		type='checkbox'
		class='toggle toggle-secondary'
		aria-label='Toggle between light and dark themes'
		data-theme-toggle
	/>
	<span class='hidden font-medium uppercase tracking-[0.22em] text-base-content/60 sm:inline'>Dark</span>
</label>

<script is:inline>
	const setupThemeToggle = () => {
		document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
			if (!(toggle instanceof HTMLInputElement) || toggle.dataset.bound === 'true') {
				return;
			}

			toggle.dataset.bound = 'true';
			toggle.addEventListener('change', () => {
				const themeApi = window.__portfolioTheme;
				if (!themeApi) {
					return;
				}

				themeApi.set(toggle.checked ? themeApi.themes.dark : themeApi.themes.light);
			});
		});

		window.__portfolioTheme?.sync();
	};

	setupThemeToggle();
	document.addEventListener('astro:page-load', setupThemeToggle);
</script>
