---
import { Image } from 'astro:assets'
import { profile } from '../../settings'
import SocialIcons from './SocialIcons.astro'
import { withBase } from '@/lib/utils'
import ProfilePicture from '@/assets/profile-picture.jpg'

const { fullName, title, location } = profile
const navItems = [
	{ label: 'Home', href: withBase('/') },
	{ label: 'Projects', href: withBase('/projects') },
	{ label: 'Experience', href: withBase('/experience') },
	{ label: 'Education', href: withBase('/education') },
	{ label: 'Resume', href: withBase('/resume') },
]
---
<aside
	class='flex h-screen w-[20rem] flex-col bg-base-200 px-4 pt-4 text-base-content'
>
	<div class='my-8 flex h-full flex-col justify-between'>
		<div>
			<div class='flex flex-col items-center text-center'>
				<Image
					class='mask mask-circle size-32 object-cover'
					src={ProfilePicture}
					alt={`Profile picture of ${fullName}`}
				/>
				<h1 class='mt-8 hidden text-lg font-black lg:block'>{fullName}</h1>
				<p class='mt-2 text-sm text-base-content/70'>{title}</p>
				<p class='mt-2 text-sm text-base-content/60'>{location}</p>
			</div>

			<div class='mx-4 mt-16'>
				<ul class='menu menu-md grow shrink space-y-2 overflow-y-auto'>
					{navItems.map((item) => (
						<li>
							<a href={item.href} class='text-lg'>{item.label}</a>
						</li>
					))}
				</ul>
			</div>
		</div>

		<div class='mx-4'>
			<SocialIcons />
		</div>
	</div>
</aside>
