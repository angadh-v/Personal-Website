---
import type { ExperienceEntry } from '@/types/portfolio'
import { template } from '@/settings'

interface Props {
	entries: ExperienceEntry[]
}

const { entries } = Astro.props
---

<ol class='space-y-8'>
	{entries.map((entry) => (
		<li class='border-b border-base-content/10 pb-8 last:border-b-0 last:pb-0'>
			<div class='flex flex-wrap items-start justify-between gap-3'>
				<div>
					<h3 class='text-xl font-bold'>{entry.role}</h3>
					<p class='mt-1 text-base-content/65'>{entry.organization}</p>
				</div>
				<div class='text-sm text-base-content/55'>
					<div>{entry.dates}</div>
					<div>{entry.location}</div>
				</div>
			</div>
			<p class='mt-3 leading-relaxed text-base-content/76'>{entry.summary}</p>
			{entry.relatedProjectSlugs.length > 0 && (
				<div class='mt-3'>
					{entry.relatedProjectSlugs.map((slug) => (
						<a href={`${template.base}/projects#${slug}`} class='link link-hover text-sm'>
							Related project
						</a>
					))}
				</div>
			)}
		</li>
	))}
</ol>
