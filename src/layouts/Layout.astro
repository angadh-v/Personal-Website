---
import { ClientRouter } from 'astro:transitions';

import BetterIcon from '../components/ui/BetterIcon.astro'
import DarkLightController from '../components/ui/DarkLightController.astro'
import Navbar from '../components/ui/Navbar.astro'
import Head from '../components/Head.astro'

import { seo, profile, template } from '../settings'
import Footer from '../components/ui/Footer.astro'

type Props = {
	title?: string
	description?: string
	image?: string
}

const {
	title = seo.default_title,
	description = seo.default_description,
	image = seo.default_image,
} = Astro.props
---

<!doctype html>
<html lang='en'>
	<head>
		{template.transitions && <ClientRouter /> }

		<Head title={title} description={description} image={image} />
	</head>
	<body class='font-[Space_Grotesk] text-base-content'>
		<div class={`drawer lg:drawer-open ${template.menu_left ? 'drawer-end' : ''}`}>
			<input id='my-drawer' type='checkbox' class='drawer-toggle' />
			<div class='drawer-content app-surface bg-base-100'>
				<div class='sticky top-0 z-50 border-b border-base-content/10 bg-base-100/78 text-base-content backdrop-blur-xl'>
					<nav class='navbar mx-auto max-w-6xl px-6'>
						<div class='navbar-start'>
							{template.menu_left &&
								<DarkLightController/>
							}
							<label for='my-drawer' class='btn btn-square btn-ghost lg:hidden'>
								<BetterIcon>
									<svg
										xmlns='http://www.w3.org/2000/svg'
										fill='none'
										viewBox='0 0 24 24'
										stroke-width='1.5'
										class='size-6 stroke-current'
									>
										<path
											stroke-linecap='round'
											stroke-linejoin='round'
											d='M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5'></path>
									</svg>
								</BetterIcon>
							</label>
						</div>
						<div class='navbar-center lg:hidden text-lg font-black'>
							{profile.fullName}
						</div>
						<div class='navbar-end'>
							{!template.menu_left &&
								<DarkLightController/>
							}
						</div>
					</nav>
				</div>
				<main class='mx-auto flex min-h-screen w-full max-w-6xl flex-col justify-between px-6 pb-8 pt-10 lg:px-8 lg:pt-16'>
					<slot />
					<Footer />
				</main>
			</div>
			<div class='drawer-side z-40'>
				<label for='my-drawer' aria-label='close sidebar' class='drawer-overlay'
				></label>
				<Navbar />
			</div>
		</div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		font-family: 'Space Grotesk', 'Avenir Next', 'Segoe UI', sans-serif;
	}

	.app-surface {
		background:
			radial-gradient(circle at 6% 10%, hsl(var(--p) / 0.08), transparent 22%),
			radial-gradient(circle at 92% 16%, hsl(var(--a) / 0.07), transparent 18%),
			radial-gradient(circle at 54% 100%, hsl(var(--s) / 0.05), transparent 20%),
			hsl(var(--b1));
	}

	code,
	pre,
	time,
	.font-mono {
		font-family: 'IBM Plex Mono', 'SFMono-Regular', monospace;
	}
</style>
